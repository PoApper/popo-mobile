source 'https://cdn.cocoapods.org/'

# Firebase 설정
$RNFirebaseAsStaticFramework = true
$FirebaseSDKVersion = '11.12.0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Firebase requires use_frameworks
use_frameworks! :linkage => :static

# 전역적으로 modular_headers 설정
use_modular_headers!

target 'popoMobile' do
  config = use_native_modules!

  # Flipper 완전히 비활성화 (Firebase compatibility)
  ENV['NO_FLIPPER'] = '1'

  # New Architecture 완전히 비활성화
  ENV['RCT_NEW_ARCH_ENABLED'] = '0'

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    # Fabric 비활성화 (Firebase compatibility)
    :fabric_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # 아이콘 폰트 추가
  pod 'RNVectorIcons', :path => '../node_modules/react-native-vector-icons'

  post_install do |installer|
    # React Native의 post install 처리
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # 각 타겟의 빌드 설정 조정
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Bitcode 비활성화
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        # 최소 iOS 버전 설정
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
        # 중복 헤더 문제 해결을 위한 설정
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
        # dSYM 파일 생성을 위한 설정 추가
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
      end

      # Privacy 번들 관련 처리
      if target.name.include?("React-Core") && target.name.include?("privacy")
        target.build_phases.each do |phase|
          next unless phase.respond_to?(:files)
          phase.files.each do |file|
            if file.display_name.include?("PrivacyInfo.xcprivacy") || file.display_name.include?("React-Core_privacy.bundle")
              file.remove_from_project
            end
          end
        end
        target.build_phases.delete_if { |phase| phase.respond_to?(:name) && phase.name.include?("Resources") }
      end
    end
  end
end
